{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:@unsafe\\s+)?(?:def|type|law)\\b|match\\b|case\\b|do\\b).*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*case\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:(?:@unsafe\\s+)?(?:def|type|law)\\b|match\\b|case\\b|do\\b).*:\\s*(?:#.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_.]*|[0-9]+(?:\\.[0-9]+)?n?"
}
